# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Python / local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Credentials and runtime state
.env
.env.*
*.lock
*.pid
NUL
logs/

# Local backup copies; the source files without this suffix are versioned
*.bak.*

# Hermes/operations runtime data — source templates remain versioned
operations/results/
operations/briefs/
operations/dispatches/
operations/stage-briefs/
operations/local-inbox/
operations/local-workspace/
operations/verifications/
operations/inputs/
operations/worker-status.json
operations/.sync.lock

# Local agent-runner state
.hermes_local_runner.lock
.worktrees/

# Candidate runtime copies (local working artifacts, not sources)
runtime-candidate/

# Archived and live runtime state produced by agents
operations/archive/
operations/watchdog/
operations/sync/

# Local pre-change backups
*.prebak
